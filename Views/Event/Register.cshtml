
@{
    ViewData["Title"] = "Register";
}

<div class="container">
    <h2>Thông tin sự kiện: @ViewBag.EventName</h2>

    <form action="/Event/Confirm" method="get" class="mt-3">
        <div class="form-group mb-3">
            <label for="count">Người đăng ký sự kiện:</label>
            <input type="text" name="name" id="name" required />
        </div>
        <a href="@Url.Action("Confirm", "Event")">Xác nhận</a>
    </form>
</div>


